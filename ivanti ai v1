          "jsCode": "// Format discovery data for the Smart Agent\nlet categoriesData, prioritiesData, offeringsData;\n\ntry {\n  categoriesData = $('Discover Categories').first().json;\n} catch (e) {\n  console.log('Categories discovery failed:', e);\n  categoriesData = { value: [] };\n}\n\ntry {\n  prioritiesData = $('Discover Priorities').first().json;\n} catch (e) {\n  console.log('Priorities discovery failed:', e);\n  prioritiesData = { value: [] };\n}\n\ntry {\n  offeringsData = $('Discover Service Request Offerings').first().json;\n} catch (e) {\n  console.log('Offerings discovery failed:', e);\n  offeringsData = { value: [] };\n}\n\nconst categories = categoriesData.value || [];\nconst priorities = prioritiesData.value || [];\nconst offerings = offeringsData.value || [];\n\nconst formattedData = {\n  categories: categories.map(cat => ({\n    id: cat.RecId,\n    name: cat.Name,\n    description: cat.Description || ''\n  })),\n  priorities: priorities.map(pri => ({\n    id: pri.RecId,\n    name: pri.Name,\n    order: pri.PriorityOrder || 0,\n    description: pri.Description || ''\n  })),\n  serviceRequestOfferings: offerings.map(off => ({\n    id: off.RecId,\n    name: off.Name,\n    description: off.Description || ''\n  }))\n};\n\n// Merge with original data from Security & Data Prep\nconst originalData = $('Security & Data Prep').first().json;\n\nreturn [{\n  json: {\n    ...originalData,\n    ivantiConfig: formattedData,\n    availableCategories: formattedData.categories.length > 0\n      ? formattedData.categories.map(c => c.name).join(', ')\n      : 'Not available',\n    availablePriorities: formattedData.priorities.length > 0\n      ? formattedData.priorities.map(p => p.name).join(', ')\n      : 'Not available',\n    availableOfferings: formattedData.serviceRequestOfferings.length > 0\n      ? formattedData.serviceRequestOfferings.map(o => o.name).join(', ')\n      : 'Not available'\n  }\n}];"
