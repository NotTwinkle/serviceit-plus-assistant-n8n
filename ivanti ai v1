          "jsCode": "// UNIVERSAL FIX FOR n8n v1.121.3\n// Use $input.all() so this works regardless of how n8n groups data.\nconst items = $input.all();\n\n// Safety check: Did we get data?\nif (items.length === 0) {\n  return [{ json: { error: \"No data received\" } }];\n}\n\nconst firstItem = items[0].json;\n\n// 1. SECURITY CHECK\nconst clientSecret = firstItem.headers ? firstItem.headers['x-extension-secret'] : '';\n// NOTE: In this environment, Code nodes cannot read $env, so we keep a static secret here.\n// Make sure this matches the value your extension sends in the x-extension-secret header.\nconst mySecret = 'my-super-secret-password-123'; // <--- CHANGE THIS TO YOUR REAL SHARED SECRET\n\nif (clientSecret !== mySecret) {\n  // Use return instead of throw to avoid crashing the workflow\n  return [{ json: { error: \"Unauthorized\", authorized: false } }];\n}\n\n// 2. DATA NORMALIZATION\nconst payload = firstItem.body || firstItem;\nconst userEmail = payload.userLoginId || \"unknown_user\";\n\n// 3. Template context (from the extension)\nconst templateContext = payload.templateContext || null;\nconst requiresFollowUp = templateContext?.requiresFollowUp || false;\nconst templateAction = templateContext?.templateAction || null;\n\n// Optional: forced intent for bypassing or overriding the router decision\nconst forcedIntent = payload.forcedIntent || null;\n\n// Return a clean object with sessionId explicitly defined\nreturn [{\n  json: {\n    sessionId: userEmail, // Memory node needs this specific key\n    query: payload.message || \"\",\n    userEmail: userEmail,\n    userContext: {\n      ticketId: payload.ticketId || null,\n      url: payload.url || \"\"\n    },\n    templateContext,\n    requiresFollowUp,\n    templateAction,\n    forcedIntent\n  }\n}];"
